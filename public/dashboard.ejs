<!DOCTYPE html>
<html>
<head>
  <title>Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body {
      background-color: #f7f9fc;
    }
    .hero {
      padding: 80px 20px;
      text-align: center;
      background: linear-gradient(135deg, #007bff, #6610f2);
      color: white;
    }
    .hero h1 {
      font-size: 3rem;
      font-weight: bold;
    }
    .hero p {
      font-size: 1.2rem;
    }
    .cta {
      margin-top: 20px;
    }
    footer {
      background-color: #f1f1f1;
      padding: 20px 0;
      text-align: center;
      margin-top: 40px;
    }
    html, body {
  height: 100%;
  margin: 0;
  display: flex;
  flex-direction: column;
}

body > main {
  flex: 1}

    .url-cell {
      max-width: 320px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      display: inline-block;
      vertical-align: middle;
    }
  </style>
</head>
<body>
  <!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">URL Shortener</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" 
            data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" 
            aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link <%= (activePage === 'home') ? 'active' : '' %>" href="/">Home</a>
        </li>
         <% if (!user) { %>
        <li class="nav-item">
          <a class="nav-link <%= (activePage === 'login') ? 'active' : '' %>" href="/login">Login</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= (activePage === 'signup') ? 'active' : '' %>" href="/signup">Signup</a>
        </li>
        <% } else { %>
           <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
        <% } %>
         <li class="nav-item">
          <a class="nav-link <%= (activePage === 'dashboard') ? 'active' : '' %>" href="/dashboard">Dashboard</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

  <main class="container my-5">
    <form action="/shorten" method="POST" class="mb-4">
      <input type="url" name="originalUrl" placeholder="Enter URL" class="form-control mb-3" required>
      <button type="submit" class="btn btn-primary">Shorten</button>
    </form>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" role="alert"><%= error %></div>
    <% } %>

  <h1 class="mb-4">Your URLs</h1>

  <% if (!arr.length) { %>
    <p class="text-muted">You haven't shortened any links yet.</p>
  <% } else { %>
  <div class="table-responsive">
    <table class="table table-hover align-middle bg-white">
      <thead>
        <tr>
          <th>Short URL</th>
          <th>Destination</th>
          <th>Clicks</th>
          <th>Created</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% arr.forEach(function(item) { %>
        <tr>
          <td>
            <a href="<%= item.s %>" target="_blank" rel="noopener"><%= item.s %></a>
            <button type="button" class="btn btn-outline-secondary btn-sm ms-2 copy-btn" data-url="<%= item.s %>">Copy</button>
          </td>
          <td>
            <span class="url-cell" title="<%= item.l %>"><%= item.l %></span>
          </td>
          <td><span class="badge bg-secondary"><%= item.c %> clicks</span></td>
          <td><%= item.createdAt ? new Date(item.createdAt).toLocaleDateString('en-US') : '' %></td>
          <td>
            <form action="/delete/<%= item.shortId %>" method="POST" onsubmit="return confirm('Are you sure?');" style="margin:0;">
              <button type="submit" class="btn btn-danger btn-sm">Delete</button>
            </form>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</main>

   <footer>
    <p>&copy; 2025 QuickLink URL Shortener. All rights reserved.</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Force a real reload when this page is restored from bfcache (e.g. via
    // the browser Back button after logout), so the server gets a chance to
    // redirect to /login if the session is gone instead of showing stale data.
    window.addEventListener('pageshow', function (event) {
      if (event.persisted) {
        location.reload();
      }
    });
  </script>
  <script>
    document.querySelectorAll('.copy-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var url = btn.getAttribute('data-url');
        navigator.clipboard.writeText(url).then(function () {
          var original = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(function () { btn.textContent = original; }, 1500);
        });
      });
    });
  </script>
</body>
</html>
