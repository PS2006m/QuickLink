<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>QuickLink - Error</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">URL Shortener</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
              data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"
              aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link <%= (activePage === 'home') ? 'active' : '' %>" href="/">Home</a></li>
         <% if (!user) { %>
          <li class="nav-item"><a class="nav-link <%= (activePage === 'login') ? 'active' : '' %>" href="/login">Login</a></li>
          <li class="nav-item"><a class="nav-link <%= (activePage === 'signup') ? 'active' : '' %>" href="/signup">Signup</a></li>
        <% } else { %>
          <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
        <% } %>
          <li class="nav-item"><a class="nav-link <%= (activePage === 'dashboard') ? 'active' : '' %>" href="/dashboard">Dashboard</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-5 text-center" style="max-width: 500px;">
    <h1 class="display-4">Oops.</h1>
    <p class="lead"><%= message %></p>
    <a href="/" class="btn btn-primary mt-3">Go home</a>
  </div>
</body>
</html>
