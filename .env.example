# Full MongoDB connection string (required - the app will not start without it).
MONGO_URI=

# Secret used to sign session cookies. Set a long random value in production.
SESSION_SECRET=

# Google Safe Browsing API key. If unset, the unsafe-URL check is skipped (dev/local).
GOOGLE_API_KEY=

# Port the server listens on.
PORT=3000

# Set to "production" when deployed (enables secure cookies, trust proxy, etc).
NODE_ENV=development
